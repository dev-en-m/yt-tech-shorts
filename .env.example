PORT=3000
NODE_ENV=development

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# YouTube Data API v3 (required for ingest scripts)
GOOGLE_API_KEY=your_youtube_api_key_here
GOOGLE_API_URL=https://www.googleapis.com/youtube/v3/channels
GOOGLE_YT_SEARCH_URL=https://www.googleapis.com/youtube/v3/search
GOOGLE_YT_VIDEOS_URL=https://www.googleapis.com/youtube/v3/videos
